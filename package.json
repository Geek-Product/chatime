{
  "name": "team-chat",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "db:push": "npm --workspace server run db:push",
    "db:seed": "npm --workspace server run db:seed",
    "gen:vapid": "npm --workspace server run gen:vapid",
    "build": "npm --workspace web run build",
    "start": "npm --workspace server run start",
    "typecheck": "npm --workspace web run typecheck && npm --workspace server run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.15.18": true,
    "es5-ext@0.10.64": true
  }
}
