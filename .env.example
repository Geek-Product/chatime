# App
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Also used for push deep links and the URLs handed out for incoming webhooks, so external
# platforms (Metabase, Grafana, …) must be able to reach this address.
APP_URL=http://localhost:5173
NODE_ENV=development

# Database (standalone Postgres service — see README "Database")
DATABASE_URL=postgres://teamchat:change-me@127.0.0.1:5434/team_chat

# Attachments (files are stored on disk; images get thumbnails in the browser)
UPLOAD_DIR=server/uploads
UPLOAD_MAX_MB=25

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Web Push (run `npm run gen:vapid` to fill these in)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
